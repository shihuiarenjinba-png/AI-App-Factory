{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/AI-App-Factory/schemas/windows-product-qa-plan-template-v1.schema.json",
  "title": "Model-authored Windows product QA plan template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_slug",
    "product_type",
    "plan_version",
    "steps",
    "allowed_diagnostics",
    "forbidden_actions",
    "success_policy"
  ],
  "properties": {
    "schema_version": { "const": "windows-product-qa-plan-template-v1" },
    "product_slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{3,39}$"
    },
    "product_type": {
      "enum": ["APP", "GAME", "GAME_3D"]
    },
    "plan_version": { "const": 1 },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "requires", "required", "params"],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "action": {
            "enum": [
              "ARTIFACT_HASH",
              "PROCESS_START",
              "PROCESS_STATUS",
              "EVENT_LOG_QUERY",
              "UIA_FIND_WINDOW",
              "UIA_FIND_CONTROL",
              "UIA_INVOKE",
              "UIA_READ_TEXT",
              "UIA_SET_TEXT"
            ]
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          },
          "required": { "type": "boolean" },
          "params": { "type": "object" }
        }
      }
    },
    "allowed_diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PROCESS_STATUS",
          "EVENT_LOG_QUERY",
          "UIA_FIND_WINDOW",
          "UIA_FIND_CONTROL",
          "UIA_READ_TEXT"
        ]
      }
    },
    "forbidden_actions": {
      "const": [
        "SOURCE_EDIT",
        "ARBITRARY_SHELL",
        "GIT_WRITE",
        "STORE_SUBMIT",
        "STORE_PUBLISH",
        "SECURITY_POLICY_CHANGE"
      ]
    },
    "success_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_steps_must_pass",
        "evidence_return_required",
        "product_e2e_authority",
        "release_authority",
        "store_authority"
      ],
      "properties": {
        "required_steps_must_pass": { "const": true },
        "evidence_return_required": { "const": true },
        "product_e2e_authority": { "const": false },
        "release_authority": { "const": false },
        "store_authority": { "const": false }
      }
    }
  }
}
